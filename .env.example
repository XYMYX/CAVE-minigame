# Kopiere diese Datei nach ".env" und fülle deine eigenen Werte ein.
# Die Datei ".env" wird nicht ins Git übernommen.

# Variante A: API-Schlüssel + Video-ID deines Livestreams.
# Die Video-ID steht in der URL hinter "v=" oder hinter "youtu.be/".
# Eine komplette URL ist auch erlaubt, das Spiel schneidet die ID heraus.
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=

# Variante B: OAuth, damit das Spiel deinen aktuellen Livestream selbst findet.
# Pfad zur JSON-Datei, die du aus der Google Cloud Console lädst.
YOUTUBE_CLIENT_SECRETS=client_secret.json
